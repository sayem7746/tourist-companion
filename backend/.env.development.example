# Local development. Placeholders only — copy to `.env` on your machine.
APP_ENV=development
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgres://tourist:tourist@127.0.0.1:5432/tourist_companion
JWT_SECRET=dev-only-insecure-jwt-secret
JWT_EXPIRES_IN=7d
ADMIN_TOKEN=dev-only-insecure-admin-token
FRONTEND_ORIGIN=http://localhost:4200
# Optional. Leave unset to retrieve-and-rank the Malaysia knowledge seed.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# CONCIERGE_RATE_LIMIT_MAX=30
# CONCIERGE_RATE_LIMIT_WINDOW_MS=60000
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# PLACES_RATE_LIMIT_MAX=60
# PLACES_RATE_LIMIT_WINDOW_MS=60000
# CONCIERGE_HISTORY_MAX_MESSAGES=20
# CONCIERGE_HISTORY_TTL_MS=604800000
# Optional places provider. Unset / no Google key → Malaysia nearby seed.
# PLACES_PROVIDER=seed
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACES_BASE_URL=https://places.googleapis.com
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# Optional weather. Unset → Open-Meteo with Malaysia climate seed fallback (no API key).
# WEATHER_PROVIDER=open-meteo
# OPEN_METEO_BASE_URL=https://api.open-meteo.com
# WEATHER_TIMEOUT_MS=2500
