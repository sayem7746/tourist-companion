# Staging. Replace every CHANGE_ME value with secrets from GitHub Environment `staging`.
# Do not copy this file into git with real credentials.
APP_ENV=staging
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://CHANGE_ME_STAGING_USER:CHANGE_ME_STAGING_PASSWORD@CHANGE_ME_STAGING_HOST:5432/tourist_companion_staging
JWT_SECRET=CHANGE_ME_STAGING_JWT_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d
ADMIN_TOKEN=CHANGE_ME_STAGING_ADMIN_TOKEN_AT_LEAST_32_CHARS
FRONTEND_ORIGIN=https://staging.CHANGE_ME_FRONTEND_HOST
LLM_API_KEY=CHANGE_ME_STAGING_LLM_API_KEY
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
CONCIERGE_RATE_LIMIT_MAX=30
CONCIERGE_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
PLACES_RATE_LIMIT_MAX=60
PLACES_RATE_LIMIT_WINDOW_MS=60000
CONCIERGE_HISTORY_MAX_MESSAGES=20
CONCIERGE_HISTORY_TTL_MS=604800000
# Optional. Leave GOOGLE_PLACES_API_KEY unset to serve the Malaysia nearby seed.
PLACES_PROVIDER=seed
GOOGLE_PLACES_API_KEY=CHANGE_ME_STAGING_GOOGLE_PLACES_API_KEY
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Optional. Open-Meteo needs no API key. Set WEATHER_PROVIDER=seed to skip live fetch.
WEATHER_PROVIDER=open-meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com
WEATHER_TIMEOUT_MS=2500
