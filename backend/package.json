{
  "name": "tourist-companion-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "db:migrate": "node-pg-migrate up --migrations-dir migrations --migration-file-language js",
    "db:migrate:down": "node-pg-migrate down --migrations-dir migrations",
    "db:migrate:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language js",
    "db:seed": "tsx src/db/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "~5.9.2",
    "vitest": "^3.0.8"
  }
}
