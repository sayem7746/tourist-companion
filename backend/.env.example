# Copy an environment example to `.env` (gitignored). Never commit real secrets.
#   cp .env.development.example .env
#
# See also: .env.development.example, .env.staging.example, .env.production.example
# CI/deploy injection: infra/SECRETS.md and .github/workflows/deploy.yml

APP_ENV=development
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://tourist:tourist@127.0.0.1:5432/tourist_companion
JWT_SECRET=dev-only-insecure-jwt-secret
JWT_EXPIRES_IN=7d
FRONTEND_ORIGIN=http://localhost:4200
# Optional. When unset, POST /concierge/chat retrieve-and-ranks malaysia-knowledge (no fake live data).
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# CONCIERGE_RATE_LIMIT_MAX=30
# CONCIERGE_RATE_LIMIT_WINDOW_MS=60000
# CONCIERGE_HISTORY_MAX_MESSAGES=20
# CONCIERGE_HISTORY_TTL_MS=604800000
